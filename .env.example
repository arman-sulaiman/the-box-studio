# Node.js 24.x. Copy this file to .env before the first setup/start.
PORT=4173
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4173
DATA_DIR=./data
ALLOW_REGISTRATION=true
ADMIN_CONTACT="Contact the administrator for subscription activation and credit recharge."
# For production set NODE_ENV=production and APP_ORIGIN=https://your-domain.example
# Run behind an HTTPS reverse proxy. Keep this process on loopback for a same-host proxy.
# TRUST_PROXY=true only when that trusted proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
# Normally leave these unset and install the bundled browser with npm run browser:install.
# CHROMIUM_PATH=/absolute/path/to/chromium
# CHROMIUM_NO_SANDBOX=false

# Optional AI removal. Never put API keys into source or client bundles.
# Rotate any key shared publicly before use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AI_PYTHON=/absolute/path/to/your/python
# Default local AI runtime is created by npm run ai:setup.
